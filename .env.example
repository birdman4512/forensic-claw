# =============================================================================
# OpenClaw - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# IMPORTANT: docker-compose's env parser does NOT treat `#` after a value as a
# comment. Inline `# ...` text gets captured as part of the value, which
# silently breaks paths and tokens. Keep comments on their own lines.
# =============================================================================

# -----------------------------------------------------------------------------
# Image
# -----------------------------------------------------------------------------
OPENCLAW_IMAGE=ghcr.io/phioranex/openclaw-docker:latest

# -----------------------------------------------------------------------------
# Host paths (edit these to point at real folders on your machine)
# -----------------------------------------------------------------------------
# OpenClaw config & session data
OPENCLAW_CONFIG_DIR=./config
# Agent workspace (mapped inside container)
OPENCLAW_WORKSPACE_DIR=./workspace
# Custom skills directory
OPENCLAW_SKILLS_DIR=./skills
# Cases / task files
OPENCLAW_CASES_DIR=./cases
# Tool-command history log
OPENCLAW_LOGS_DIR=./logs

# Absolute host paths (REQUIRED for the docker-in-docker tool wrappers
# - plaso, vol2, memprocfs, nuclei). The docker daemon resolves bind-mounts
# against the host filesystem, so these can't be relative. Set them to the
# absolute path of OPENCLAW_CASES_DIR above.
# Example (Linux):   OPENCLAW_CASES_HOST_PATH=/home/you/forensic-claw/cases
# Example (Windows): OPENCLAW_CASES_HOST_PATH=C:/Users/you/forensic-claw/cases
OPENCLAW_CASES_HOST_PATH=

# -----------------------------------------------------------------------------
# Tool container images (consumed by tools/run-*-tool.sh wrappers)
# Override here if you want to pin a version or use a forked image.
# - PLASO and NUCLEI: upstream official images on Docker Hub.
# - VOL2: blacktop/volatility:2.6 is a community-maintained image. Swap if
#   you prefer sk4la/volatility, cincan/volatility, etc.
# - MEMPROCFS: no upstream Docker image. Build it locally first:
#     docker build -t forensic-claw-memprocfs:latest tools-images/memprocfs/
#   See tools-images/README.md for details.
# -----------------------------------------------------------------------------
FORENSIC_CLAW_PLASO_IMAGE=log2timeline/plaso:latest
FORENSIC_CLAW_NUCLEI_IMAGE=projectdiscovery/nuclei:latest
FORENSIC_CLAW_VOL2_IMAGE=blacktop/volatility:2.6
FORENSIC_CLAW_MEMPROCFS_IMAGE=forensic-claw-memprocfs:latest

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------
# Leave blank and run `./scripts/setup-workspace.sh` - it will auto-generate
# a token here. Or run `openssl rand -hex 32` and paste the result.
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
# 'lan' for container use, 'local' for localhost only
OPENCLAW_GATEWAY_BIND=lan
OPENCLAW_TZ=Australia/Brisbane

# -----------------------------------------------------------------------------
# Bonjour / mDNS
# Leave blank for auto-detect. Set 1 to force-disable, 0 to force-enable.
# -----------------------------------------------------------------------------
OPENCLAW_DISABLE_BONJOUR=

# -----------------------------------------------------------------------------
# AI Provider Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
# Optional
OPENAI_ORG_ID=

ANTHROPIC_API_KEY=

# Claude web session (only needed if using Claude OAuth/web auth)
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# -----------------------------------------------------------------------------
# Docker socket access for the in-image tool wrappers
# (plaso/vol2/memprocfs/nuclei call out to upstream images via /var/run/docker.sock).
# DOCKER_GID must match the group id that owns /var/run/docker.sock on the host.
# Linux:                 stat -c '%g' /var/run/docker.sock
# macOS (Docker Desktop): typically 0
# Windows (Docker Desktop, WSL2 backend): typically 0 or 1000
# -----------------------------------------------------------------------------
DOCKER_GID=999

# Optional: enable OpenClaw's separate sub-agent sandbox feature (each
# sub-agent gets its own isolated container). Off by default; uses the same
# docker socket above.
OPENCLAW_SANDBOX=0

# -----------------------------------------------------------------------------
# Observability (optional - OpenTelemetry)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=openclaw
OTEL_SEMCONV_STABILITY_OPT_IN=
OPENCLAW_OTEL_PRELOADED=
