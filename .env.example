# =============================================================================
# OpenClaw – Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Image
# -----------------------------------------------------------------------------
OPENCLAW_IMAGE=ghcr.io/phioranex/openclaw-docker:latest

# -----------------------------------------------------------------------------
# Host paths (edit these to point at real folders on your machine)
# -----------------------------------------------------------------------------
OPENCLAW_CONFIG_DIR=./config          # OpenClaw config & session data
OPENCLAW_WORKSPACE_DIR=./workspace    # Agent workspace (mapped inside container)
OPENCLAW_SKILLS_DIR=./skills          # Custom skills directory
OPENCLAW_CASES_DIR=./cases            # Cases / task files

# -----------------------------------------------------------------------------
# Gateway
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=              # Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_PORT=18789
OPENCLAW_BRIDGE_PORT=18790
OPENCLAW_GATEWAY_BIND=lan            # 'lan' for container use, 'local' for localhost only
OPENCLAW_TZ=Australia/Brisbane

# -----------------------------------------------------------------------------
# Bonjour / mDNS
# Leave blank for auto-detect. Set 1 to force-disable, 0 to force-enable.
# -----------------------------------------------------------------------------
OPENCLAW_DISABLE_BONJOUR=

# -----------------------------------------------------------------------------
# AI Provider Keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_ORG_ID=                       # Optional

ANTHROPIC_API_KEY=

# Claude web session (only needed if using Claude OAuth/web auth)
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# -----------------------------------------------------------------------------
# Sandbox (sub-agent isolation via Docker-in-Docker)
# Set OPENCLAW_SANDBOX=1 to enable. Requires docker.sock mount – see compose.
# Run: stat -c '%g' /var/run/docker.sock  to find DOCKER_GID on Linux.
# On macOS with Docker Desktop the default GID is typically 0.
# -----------------------------------------------------------------------------
OPENCLAW_SANDBOX=0
DOCKER_GID=999

# -----------------------------------------------------------------------------
# Observability (optional – OpenTelemetry)
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=openclaw
OTEL_SEMCONV_STABILITY_OPT_IN=
OPENCLAW_OTEL_PRELOADED=
