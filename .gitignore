# Secrets — never commit
.env
.env.local
.env.*.local

# Runtime data created by the gateway / agent
config/
logs/
workspace/.openclaw/

# Case data (often sensitive: evidence, findings, credentials in worklogs).
# Templates and the EXAMPLE-001 skeleton are tracked; real cases are not.
cases/*
!cases/templates/
!cases/EXAMPLE-001/
# Within EXAMPLE-001, never track actual evidence or generated outputs.
cases/EXAMPLE-001/evidence/*
!cases/EXAMPLE-001/evidence/.gitkeep
cases/EXAMPLE-001/outputs/*
!cases/EXAMPLE-001/outputs/.gitkeep

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node (in case anyone runs anything locally)
node_modules/
