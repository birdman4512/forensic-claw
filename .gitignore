# Secrets — never commit
.env
.env.local
.env.*.local

# Runtime data created by the gateway / agent
config/
config-local-analyst/
logs/
workspace/.openclaw/

# Live agent-mutable files (seeded from workspace/*.template.md by
# scripts/setup-workspace.sh). Templates ship in git, live copies don't.
workspace/MEMORY.md
workspace/USER.md

# Case data (often sensitive: evidence, findings, credentials in worklogs).
# Only the templates folder is tracked. Real case folders, including the
# EXAMPLE-001 skeleton seeded by scripts/setup-workspace.sh, stay local.
cases/*
!cases/templates/

# OS / editor cruft
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.vscode/
.idea/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node (in case anyone runs anything locally)
node_modules/
